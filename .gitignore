# Dependencies
node_modules/
**/node_modules/

# Environment variables / secrets
.env
.env.*
**/.env
**/.env.*

# Keep example environment files
!.env.example
!**/.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build files
dist/
build/
**/dist/
**/build/

# Vite
.vite/

# Uploads / user-generated files
uploads/
**/uploads/

# Temporary files
tmp/
temp/

# OS files
.DS_Store
Thumbs.db

# IDE / editor files
.vscode/
.idea/

# OS/editor temporary files
*.swp
*.swo

# Coverage
coverage/
.nyc_output/

# Runtime data
*.pid
*.seed
*.pid.lock

# Local database files
*.sqlite
*.sqlite3

# Python cache (if any Python scripts are added later)
__pycache__/
*.py[cod]

# Environment-specific files
.env.local
.env.development.local
.env.test.local
.env.production.local
